<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Seguir grabando con la app en segundo plano o la pantalla apagada: servicio en primer
         plano de tipo micrófono, con su aviso en la barra. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/dotrino_locales_config"
        android:supportsRtl="false"
        android:theme="@style/Theme.Recorder">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".RecorderService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <!-- Compartir una grabación: el archivo sale por un content:// de solo lectura, sin
             AndroidX (RecordingProvider). -->
        <provider
            android:name=".RecordingProvider"
            android:authorities="com.dotrino.recorder.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
