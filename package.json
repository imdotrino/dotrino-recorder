{
  "name": "dotrino-recorder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Grabadora de audio de calidad: WAV sin pérdida o comprimido, medidor de nivel y ganancia. Las grabaciones se quedan en tu aparato.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.js",
    "i18n:android": "node scripts/i18n-to-android.mjs"
  },
  "dotrino": {
    "kind": "app",
    "platforms": [
      "pwa",
      "ios",
      "android"
    ]
  },
  "dependencies": {
    "@dotrino/compat": "0.5.0",
    "@dotrino/identity": "0.135.0",
    "@dotrino/install": "0.3.3",
    "@dotrino/nav": "0.3.0",
    "@dotrino/reputation": "0.12.4",
    "@dotrino/store": "0.14.1",
    "@dotrino/theme": "0.1.0",
    "@dotrino/topbar": "0.17.0"
  },
  "devDependencies": {
    "@dotrino/prerender": "0.1.0",
    "vite": "7.3.1"
  }
}
